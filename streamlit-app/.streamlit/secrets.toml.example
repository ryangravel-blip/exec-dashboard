# Copy these into the app's Secrets manager on Streamlit Community Cloud
# (App -> Settings -> Secrets) — do NOT commit a real secrets.toml to this repo.
#
# Values match the exec_dashboard Vercel project's environment variables
# (Vercel -> exec_dashboard -> Settings -> Environment Variables) — same
# Snowflake key pair can be reused, or generate a fresh one scoped to this app.

[snowflake]
account = "XPAHNKF-AMPERITY_DATA_WAREHOUSE"
username = "RYAN.GRAVEL@AMPERITY.COM"
warehouse = "READ"
role = "FINANCE_SU"
database = "load"
# Paste the PEM private key contents here, with literal \n for line breaks
# (same format as the Vercel SNOWFLAKE_PRIVATE_KEY env var).
private_key = "-----BEGIN PRIVATE KEY-----\nMIIe...\n-----END PRIVATE KEY-----\n"
